# Copie para .env.local e preencha pelo menos uma chave. Sem nenhuma, o site
# funciona em modo demonstração (respostas pré-geradas).

# Groq — gratuito: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini (fallback) — gratuito: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# URL pública do site (usada nas imagens de compartilhamento)
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app
